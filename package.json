{
  "name": "telugu-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A Remotion-based Telugu documentary Shorts video generator",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render:short": "remotion render src/index.tsx TeluguShort out/telugu-short.mp4 --codec=h264"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.541",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "typescript": "5.8.3"
  }
}
